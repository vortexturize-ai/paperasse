{
  "expo": {
    "name": "Paperasse",
    "slug": "paperasse",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": true,
      "bundleIdentifier": "com.paperasse.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FF8A1F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.paperasse.app",
      "allowBackup": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      [
        "expo-sharing",
        {
          "android": {
            "enabled": true,
            "singleShareMimeTypes": [
              "image/*",
              "application/pdf",
              "application/zip",
              "text/plain"
            ],
            "multipleShareMimeTypes": [
              "image/*",
              "application/pdf"
            ]
          },
          "ios": {
            "enabled": true,
            "activationRule": {
              "supportsImageWithMaxCount": 10,
              "supportsFileWithMaxCount": 10,
              "supportsText": true
            }
          }
        }
      ],
      "expo-document-picker",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Paperasse utilise l’appareil photo pour scanner tes documents.",
          "photosPermission": "Paperasse lit les photos que tu choisis pour les ranger.",
          "microphonePermission": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Paperasse utilise Face ID pour protéger tes documents."
        }
      ],
      "expo-notifications",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "backgroundColor": "#1F3C88"
        }
      ],
      "./plugins/withBundledOcrModel",
      "./plugins/withModernCmake",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Paperasse utilise l’appareil photo pour lire le code 2D-Doc des papiers officiels.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "scheme": "paperasse"
  }
}
